# Скопировать в .env рядом с app.py и заполнить.

# Куда класть токен, очередь и историю. Каталог должен существовать.
STATE_FILE=/opt/vk-bot/state.json

# Секрет для мини-приложения. Его же вводить в поле «Ключ доступа» в приложении.
# Сгенерировать: openssl rand -hex 24
ADMIN_SECRET=

# Секрет для бота. BotHelp шлёт его в заголовке X-Bot-Secret.
# Пустое значение отключает проверку — так оставлять нельзя, эндпоинт открыт в интернет.
BOT_SECRET=

# Сообщество по умолчанию, если бот не передал group_id.
VK_GROUP_ID=236838246

# Откуда разрешено обращаться мини-приложению (адрес GitHub Pages, без слэша).
ALLOWED_ORIGIN=https://hawkey-prog.github.io

VK_API_VERSION=5.199
